    dqv:inCategory iso:ProductQuality .

aiqv:Security a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC 25010:2023, 3.6"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader dqv:Dimension ;
    skos:definition "Capability of a product to protect information and data so that persons or other products have the degree of data access appropriate to their types and levels of authorization, and to defend against attack patterns by malicious actors"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Security"@en ;
    dqv:inCategory iso:ProductQuality .

aiqv:Selfdescriptiveness a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC 25010:2023, 3.4.8"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:InteractionCapability ;
    skos:definition "Capability of a product to present appropriate information, where needed by the user, to make its capabilities and use immediately obvious to the user without excessive interactions with a product or other resources"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Self-descriptiveness"@en ;
    dqv:inCategory iso:ProductQuality .

aiqv:ServiceAccessibility a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC TS 25011:2017, 3.2.2.5, IT service is replaced by AI service"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:ServiceUsability ;
    skos:definition "Degree to which an AI service can be used by people with the widest range of characteristics and capabilities to achieve a specified goal in a specified context of use"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "ServiceAccessibility"@en ;
    dqv:inCategory iso:AIServiceQuality .

aiqv:ServiceAdaptability a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC DIS 25059:2025, 3.4.2"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader dqv:Dimension ;
    skos:definition """Degree to which a service can be adapted based on factors such as functions, responsibility, skill of
employees, communication style with users or instruments available"""@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Service Adaptability"@en ;
    dqv:inCategory iso:AIServiceQuality .

aiqv:ServiceAnalysability a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC TS 25011:2017, 3.2.8.1,  IT service is replaced by AI service"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:ServiceMaintainability ;
    skos:definition "Degree of effectiveness and efficiency with which an AI service can be analysed for deficiencies, gaps and failures"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Service Analysability"@en ;
    dqv:inCategory iso:AIServiceQuality .

aiqv:ServiceAppropriatenessRecognizability a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC TS 25011:2017, 3.2.2.1, IT service is replaced by AI service"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:ServiceUsability ;
    skos:definition "Degree to which users  can recognize whether an AI service is appropriate for their needs"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Service Appropriateness Recognizability"@en ;
    dqv:inCategory iso:AIServiceQuality .

aiqv:ServiceAvailability a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC TS 25011:2017, 3.2.4.3, IT service is replaced by AI service"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:ServiceReliability ;
    skos:definition "Degree to which an AI service is available to users when needed"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Service Availability"@en ;
    dqv:inCategory iso:AIServiceQuality .

aiqv:ServiceConfidentiality a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC TS 25011:2017, 3.2.3.1, IT service is replaced by AI service"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:ServiceSecurity ;
    skos:definition "Degree to which an AI service ensures that data are accessible only to those authorized to have access"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Service Confidentiality"@en ;
    dqv:inCategory iso:AIServiceQuality .

aiqv:ServiceIntegrity a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC TS 25011:2017, 3.2.3.2, IT service is replaced by AI service"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:ServiceSecurity ;
    skos:definition "Degree to which an AI service prevents unauthorized access to or modification of data whether accidently or intentionally"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Service Integrity"@en ;
    dqv:inCategory iso:AIServiceQuality .

aiqv:ServiceInterfaceAppearance a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC TS 25011:2017, 3.2.5.3, IT service is replaced by AI service"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:Tangibility ;
    skos:definition "Degree to which the interface of the service has an appearance or other physical properties that are pleasing and satisfying for the user"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Service Interface Appearance"@en ;
    dqv:inCategory iso:AIServiceQuality .

aiqv:ServiceLearnability a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC TS 25011:2017, 3.2.2.2, IT service is replaced by AI service"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:ServiceUsability ;
    skos:definition "Degree to which an AI service can be learned by users to achieve a specified level of effectiveness, efficiency, freedom from risk and satisfaction within a specified amount of time and context of use"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Service Learnability"@en ;
    dqv:inCategory iso:AIServiceQuality .

aiqv:ServiceMaintainability a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC TS 25011:2017, 3.2.8,  IT service is replaced by AI service"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader dqv:Dimension ;
    skos:definition "Degree of effectiveness and efficiency with which the AI service can be modified by the service provider"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Service Maintainability"@en ;
    dqv:inCategory iso:AIServiceQuality .

aiqv:ServiceModifiability a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC TS 25011:2017, 3.2.8.2,  IT service is replaced by AI service"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:ServiceMaintainability ;
    skos:definition "Degree to which an AI service can be effectively and efficiently modified without introducing defects or degrading existing AI service quality"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Service Modifiability"@en ;
    dqv:inCategory iso:AIServiceQuality .

aiqv:ServiceOperability a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC TS 25011:2017, 3.2.2.3, IT service is replaced by AI service"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:ServiceUsability ;
    skos:definition "Degree to which an AI service has attributes that make it easy to operate and control"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Service Operability"@en ;
    dqv:inCategory iso:AIServiceQuality .

aiqv:ServiceRecoverability a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC TS 25011:2017, 3.2.4.2, IT service is replaced by AI service"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:ServiceReliability ;
    skos:definition "Degree to which, in the event of an interruption or a failure or disaster, the original AI service and its functions and data can be re-established and made accessible"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Service Recoverability"@en ;
    dqv:inCategory iso:AIServiceQuality .

aiqv:ServiceReliability a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC TS 25011:2017, 3.2.4, IT service is replaced by AI service"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader dqv:Dimension ;
    skos:definition "Degree to which an AI service provides consistent and stable AI service outcomes"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Service Reliability"@en ;
    dqv:inCategory iso:AIServiceQuality .

aiqv:ServiceSecurity a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC TS 25011:2017, 3.2.3, IT service is replaced by AI service"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader dqv:Dimension ;
    skos:definition "Degree to which an AI service protects both user’s assets and access to their information so that users have the degree of information access appropriate to their levels of authorization"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Service Security"@en ;
    dqv:inCategory iso:AIServiceQuality .

aiqv:ServiceTestability a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC TS 25011:2017, 3.2.8.3,  IT service is replaced by AI service"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:ServiceMaintainability ;
    skos:definition "Degree of effectiveness and efficiency with which test criteria can be established for an AI service and tests can be performed to determine whether those criteria have been met"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Service Testability"@en ;
    dqv:inCategory iso:AIServiceQuality .

aiqv:ServiceUsability a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC TS 25011:2017, 3.2.2, IT service is replaced by AI service"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader dqv:Dimension ;
    skos:definition "Degree to which an AI service can be used by specified users to achieve specified goals with effectiveness, efficiency and satisfaction in a specified context of use"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Service Usability"@en ;
    dqv:inCategory iso:AIServiceQuality .

aiqv:ServiceUserErrorProtection a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC TS 25011:2017, 3.2.2.4, IT service is replaced by AI service"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:ServiceUsability ;
    skos:definition "Degree to which an AI service protects users against making errors"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Service User Error Protection"@en ;
    dqv:inCategory iso:AIServiceQuality .

aiqv:SocietalAndEthicalRiskMitigation a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC 25059:2023, 3.3.1 (minor change to wording), ISO/IEC DIS 25059:2025. 3.3.2"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:RiskMitigation ;
    skos:definition "Degree to which a product or system mitigates the potential societal or ethical risks"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Societal And Ethical Risk Mitigation"@en ;
    dqv:inCategory iso:QualityInUse .

aiqv:Suitability a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC 25019:2023,3.2.1.3"@en,
        "ISO/IEC TS 25011:2017, 3.2.1, IT service is replaced by AI service"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader dqv:Dimension,
        iso:Beneficialness ;
    skos:definition "Degree to which an AI service meets stated and implied needs when used in a specified context of use"@en,
        "Extent to which behaviours or outcomes, or both, of a product meet specified quality requirements when used"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Suitability"@en ;
    dqv:inCategory iso:AIServiceQuality,
        iso:QualityInUse .

aiqv:SystemPerformance a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "AI Act Article 3(18)"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader dqv:Dimension ;
    skos:definition "performance of an AI system means the ability of an AI system to achieve its intended purpose"@en ;
    skos:inScheme aiqv:eu-aiact-classes ;
    skos:prefLabel "System Performance"@en ;
    dqv:inCategory eu-aiact:SystemQuality .

aiqv:SystemQualityDimensions a rdfs:Class,
        skos:Concept,
        dqv:Category ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader dqv:Category ;
    skos:definition "Quality associated with AI Systems"@en ;
    skos:inScheme aiqv:eu-aiact-classes ;
    skos:prefLabel "System Quality Dimensions"@en .

aiqv:Tangibility a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC TS 25011:2017, 3.2.5, IT service is replaced by AI service"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader dqv:Dimension ;
    skos:definition "Degree to which the tangible aspects of the AI service effectively communicate and support the service"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Tangibility"@en ;
    dqv:inCategory iso:AIServiceQuality .

aiqv:Testability a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC 25010:2023, 3.7.5"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:Flexibility ;
    skos:definition "Capability of a product to enable an objective and feasible test to be designed and performed to determine whether a requirement is met"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Testability"@en ;
    dqv:inCategory iso:ProductQuality .

aiqv:TimeBehaviour a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC 25010:2023, 3.2.1"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:PerformanceEfficiency ;
    skos:definition "Capability of a product to perform its specified function under specified conditions so that the response time and throughput rates meet the requirements"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Time Behaviour"@en ;
    dqv:inCategory iso:ProductQuality .

aiqv:Timeliness a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC TS 25011:2017, 3.2.6.1,  IT service is replaced by AI service"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:Responsiveness ;
    skos:definition "Degree to which an AI service delivers outcomes within time limits"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Timeliness"@en ;
    dqv:inCategory iso:AIServiceQuality .

aiqv:Traceability a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC DIS 25059:2025, 3.4.1"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:ServiceSecurity ;
    skos:definition "Degree to which the AI service outcomes can be traced to or from the user needs"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Traceability"@en ;
    dqv:inCategory iso:AIServiceQuality .

aiqv:Transparency a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "AI Act Article 13"@en,
        "ISO/IEC 25059:2023, 3.1.5 , ISO/IEC DIS 25059:2025, 3.1.5"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader dqv:Dimension,
        iso:Acceptability,
        iso:InteractionCapability ;
    skos:definition "Degree to which appropriate information about the AI system is communicated to relevant stakeholders"@en,
        "Transparency of the operation of AI system"@en ;
    skos:inScheme aiqv:eu-aiact-classes,
        aiqv:iso-25059-classes ;
    skos:prefLabel "Transparency"@en ;
    dqv:inCategory eu-aiact:ModelQuality,
        eu-aiact:SystemQuality,
        iso:ProductQuality,
        iso:QualityInUse .

aiqv:Trustworthiness a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC 25019:2023,3.2.3.2"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:Acceptability ;
    skos:definition "Extent to which users or stakeholders  have confidence that their expectations are met in a verifiable way"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Trustworthiness"@en ;
    dqv:inCategory iso:QualityInUse .

aiqv:Usability a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC 25019:2023,3.2.1.1"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:Beneficialness ;
    skos:definition "Extent to which a system, product or service can be used by specified users  to achieve specified goals with effectiveness, efficiency, and satisfaction in a specified context of use"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Usability"@en ;
    dqv:inCategory iso:QualityInUse .

aiqv:UserAssistance a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC 25010:2023, 3.4.7"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:InteractionCapability ;
    skos:definition "Capability of a product to be used by people with the widest range of characteristics and capabilities to achieve specified goals in a specified context of use"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "User Assistance"@en ;
    dqv:inCategory iso:ProductQuality .

aiqv:UserControllability a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC 25059:2023, 3.2.1 & ISO/IEC DIS 25059:2025, 3.2.1"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:InteractionCapability ;
    skos:definition "Degree to which a user can appropriately intervene in an AI system’s functioning in a timely manner"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "User Controllability"@en ;
    dqv:inCategory iso:ProductQuality .

aiqv:UserEngagement a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC 25010:2023, 3.4.5"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:InteractionCapability ;
    skos:definition "Capability of a product to present functions and information in an inviting and motivating manner encouraging continued interaction"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "User Engagement"@en ;
    dqv:inCategory iso:ProductQuality .

aiqv:UserErrorProtection a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC 25010:2023, 3.4.4"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:InteractionCapability ;
    skos:definition "Capability of a product to prevent operation errors"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "User Error Protection"@en ;
    dqv:inCategory iso:ProductQuality .

aiqv:Visibility a rdfs:Class,
        skos:Concept,
        dqv:Dimension ;
    dct:source "ISO/IEC TS 25011:2017, 3.2.5.1, IT service is replaced by AI service"@en ;
    rdfs:isDefinedBy aiqv: ;
    sw:term_status "accepted"@en ;
    skos:broader iso:Tangibility ;
    skos:definition "Degree to which users have insight into the capabilities of the AI service, how they will be delivered, and progress toward their completion during delivery"@en ;
    skos:inScheme aiqv:iso-25059-classes ;
    skos:prefLabel "Visibility"@en ;
    dqv:inCategory iso:AIServiceQuality .

