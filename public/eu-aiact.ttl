<https://w3id.org/aiqv> a owl:Ontology,
        profile:Profile ;
    dct:bibliographicCitation "Harshvardhan J. Pandit, Beatriz Esteves, Georg P. Krog, Paul Ryan, Delaram Golpayegani, Julian Flake (2025) Data Privacy Vocabulary (DPV) – Version 2.0. In: Demartini, G., et al. The Semantic Web – ISWC 2024. ISWC 2024. Lecture Notes in Computer Science, vol 15233. Springer, Cham. https://doi.org/10.1007/978-3-031-77847-6_10" ;
    dct:conformsTo "http://www.w3.org/2000/01/rdf-schema",
        "http://www.w3.org/2004/02/skos/core" ;
    dct:created "2026-05-12"@en ;
    dct:creator [ a dct:Agent,
                foaf:Person ;
            org:memberOf [ a foaf:Organization ;
                    foaf:name "ADAPT" ] ;
            foaf:name "Harshvardhan J. Pandit" ] ;
    dct:description "AIQV"@en ;
    dct:identifier "https://w3id.org/aiqv" ;
    dct:issued "2026-05-12"@en ;
    dct:license <https://www.w3.org/copyright/document-license-2023/> ;
    dct:modified "2026-05-12"@en ;
    dct:publisher <https://www.w3.org/> ;
    dct:source <https://www.w3.org/groups/cg/dpvcg/> ;
    dct:title "AIQV"@en ;
    bibo:doi "10.5281/zenodo.12505841" ;
    bibo:status "http://purl.org/ontology/bibo/status/published" ;
    vann:preferredNamespacePrefix "aiqv" ;
    vann:preferredNamespaceUri "https://w3id.org/aiqv#" ;
    rdfs:Label "AIQV"@en ;
    owl:versionIRI <https://w3id.org/aiqv> ;
    owl:versionInfo "0.1" ;
    profile:hasResource aiqv:serialisation-html,
        aiqv:serialisation-ttl ;
    profile:isProfileOf rdfs:,
        skos: ;
    foaf:logo <https://w3id.org/dpv/media/logo.png> ;
    schema:version "0.1" .

aiqv:serialisation-html a profile:ResourceDescriptor ;
    dct:conformsTo <https://www.w3.org/TR/html/> ;
    dct:format <https://www.iana.org/assignments/media-types/text/html> ;
    dct:title "AIQV - HTML serialisation" ;
    profile:hasArtifact <https://w3id.org/aiqv/aiqv.html> ;
    profile:hasRole role:specification .

aiqv:serialisation-ttl a profile:ResourceDescriptor ;
    dct:conformsTo <https://www.w3.org/TR/turtle/> ;
    dct:format <https://www.iana.org/assignments/media-types/text/turtle> ;
    dct:title "AIQV - Turtle serialisation" ;
    profile:hasArtifact <https://w3id.org/aiqv/aiqv.ttl> ;
    profile:hasRole role:vocabulary .

aiqv:eu-aiact-classes a skos:ConceptScheme .

